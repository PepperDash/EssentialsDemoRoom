<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectType>ProgramLibrary</ProjectType>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PepperDash.Essentials.Demo.Room</RootNamespace>
    <AssemblyName>epi-essentials-demo.4Series</AssemblyName>
    <AssemblyTitle>PepperDash.Essentials.Demo.Room</AssemblyTitle>
    <Title>Essentials Demo Room</Title>
    <Description>Room plugin for the PepperDash Essentials v3 demo system. All device behavior is mocked so the program can run on any 4-series processor with no real AV hardware attached.</Description>
    <Authors>PepperDash Technology</Authors>
    <Company>PepperDash Technology</Company>
    <Copyright>Copyright 2026</Copyright>
    <Version>1.0.0-local</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <PackageId>PepperDash.Essentials.Plugin.Demo.Room</PackageId>
    <PackageProjectUrl>https://github.com/PepperDash/EssentialsDemoRoom</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PepperDash/EssentialsDemoRoom</RepositoryUrl>
    <PackageTags>crestron net8 essentials pepperdash pepperdashessentials epi essentials plugin demo</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PepperDashEssentials" Version="3.0.0-rc.4">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <!-- Installs the repo's git hooks (.husky/) on a developer's first restore. Skipped on CI, which
       sets CI=true, and anywhere HUSKY=0. -->
  <Target Name="Husky" BeforeTargets="Restore;CollectPackageReferences" Condition="'$(HUSKY)' != '0' and '$(CI)' != 'true'">
    <Exec Command="dotnet tool restore" StandardOutputImportance="Low" StandardErrorImportance="High" WorkingDirectory=".." />
    <Exec Command="dotnet husky install" StandardOutputImportance="Low" StandardErrorImportance="High" WorkingDirectory=".." />
  </Target>
</Project>
